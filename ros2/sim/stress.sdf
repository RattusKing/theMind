<?xml version="1.0"?>
<!-- The stress run's house: the physics test's house, run for hours, with a
     battery that drains in minutes and recharges when the robot docks, and
     three people who come and go. Derived from house.sdf.
     A small house for theMind's physics test: a kitchen (x < 0) and a garden
     (x > 0) joined by a doorway, a wheeled robot whose battery drains as it
     runs, a kettle, a bench, an apple tree, and Sam, who is moved in and out
     by the test. The robot sees with a logical camera, which reports what is
     in view without rendering, so it runs headless anywhere. It runs faster
     than real time on purpose: the mind must live on simulated time. -->
<sdf version="1.9">
  <world name="house">
    <physics name="fast" type="ignored">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>8.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-logical-camera-system" name="gz::sim::systems::LogicalCamera"/>

    <light type="directional" name="sun">
      <pose>0 0 10 0 0 0</pose>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry>
        </collision>
      </link>
    </model>

    <!-- The wall between kitchen and garden, with a two-metre doorway at y = 0. -->
    <model name="wall">
      <static>true</static>
      <link name="north">
        <pose>0 3.5 1 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.2 5 2</size></box></geometry></collision>
      </link>
      <link name="south">
        <pose>0 -3.5 1 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.2 5 2</size></box></geometry></collision>
      </link>
    </model>

    <model name="kettle">
      <static>true</static>
      <pose>-2.4 0.3 0.15 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.2 0.2 0.3</size></box></geometry></collision>
      </link>
    </model>
    <model name="bench">
      <static>true</static>
      <pose>4.9 0.4 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.5 1.5 0.5</size></box></geometry></collision>
      </link>
    </model>
    <model name="apple_tree">
      <static>true</static>
      <pose>5.6 -1.2 1.0 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.3</radius><length>2</length></cylinder></geometry></collision>
      </link>
    </model>

    <!-- Three people wait far away until the stress run brings them in. -->
    <model name="sam">
      <static>true</static>
      <pose>-30 0 0.85 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.25</radius><length>1.7</length></cylinder></geometry></collision>
      </link>
    </model>
    <model name="ana">
      <static>true</static>
      <pose>-30 3 0.85 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.25</radius><length>1.7</length></cylinder></geometry></collision>
      </link>
    </model>
    <model name="tom">
      <static>true</static>
      <pose>-30 6 0.85 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.25</radius><length>1.7</length></cylinder></geometry></collision>
      </link>
    </model>

    <model name="robot">
      <pose>-4 0 0.1 0 0 0</pose>
      <link name="chassis">
        <inertial>
          <mass>2.0</mass>
          <inertia><ixx>0.02</ixx><iyy>0.03</iyy><izz>0.04</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <collision name="collision"><geometry><box><size>0.4 0.3 0.1</size></box></geometry></collision>
        <sensor name="eyes" type="logical_camera">
          <pose>0.2 0 0.15 0 0 0</pose>
          <logical_camera>
            <near>0.1</near>
            <far>4.0</far>
            <horizontal_fov>1.4</horizontal_fov>
            <aspect_ratio>1.0</aspect_ratio>
          </logical_camera>
          <always_on>1</always_on>
          <update_rate>5</update_rate>
          <topic>robot/eyes</topic>
        </sensor>
      </link>
      <link name="left_wheel">
        <pose>0.05 0.18 0 -1.5707 0 0</pose>
        <inertial>
          <mass>0.3</mass>
          <inertia><ixx>0.0005</ixx><iyy>0.0005</iyy><izz>0.001</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <collision name="collision"><geometry><cylinder><radius>0.08</radius><length>0.04</length></cylinder></geometry></collision>
      </link>
      <link name="right_wheel">
        <pose>0.05 -0.18 0 -1.5707 0 0</pose>
        <inertial>
          <mass>0.3</mass>
          <inertia><ixx>0.0005</ixx><iyy>0.0005</iyy><izz>0.001</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <collision name="collision"><geometry><cylinder><radius>0.08</radius><length>0.04</length></cylinder></geometry></collision>
      </link>
      <link name="caster">
        <pose>-0.15 0 -0.04 0 0 0</pose>
        <inertial>
          <mass>0.1</mass>
          <inertia><ixx>0.0001</ixx><iyy>0.0001</iyy><izz>0.0001</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <collision name="collision">
          <geometry><sphere><radius>0.04</radius></sphere></geometry>
          <surface><friction><ode><mu>0</mu><mu2>0</mu2></ode></friction></surface>
        </collision>
      </link>
      <joint name="left_wheel_joint" type="revolute">
        <parent>chassis</parent>
        <child>left_wheel</child>
        <axis><xyz expressed_in="__model__">0 1 0</xyz></axis>
      </joint>
      <joint name="right_wheel_joint" type="revolute">
        <parent>chassis</parent>
        <child>right_wheel</child>
        <axis><xyz expressed_in="__model__">0 1 0</xyz></axis>
      </joint>
      <joint name="caster_joint" type="fixed">
        <parent>chassis</parent>
        <child>caster</child>
      </joint>
      <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
        <left_joint>left_wheel_joint</left_joint>
        <right_joint>right_wheel_joint</right_joint>
        <wheel_separation>0.36</wheel_separation>
        <wheel_radius>0.08</wheel_radius>
        <topic>/model/robot/cmd_vel</topic>
        <odom_topic>/model/robot/odometry</odom_topic>
      </plugin>
      <!-- Drains over about eight simulated minutes; recharges when docked. -->
      <plugin filename="gz-sim-linearbatteryplugin-system"
              name="gz::sim::systems::LinearBatteryPlugin">
        <battery_name>linear_battery</battery_name>
        <voltage>12.592</voltage>
        <open_circuit_voltage_constant_coef>12.694</open_circuit_voltage_constant_coef>
        <open_circuit_voltage_linear_coef>-3.1424</open_circuit_voltage_linear_coef>
        <initial_charge>0.07</initial_charge>
        <capacity>0.07</capacity>
        <resistance>0.061523</resistance>
        <smooth_current_tau>1.9499</smooth_current_tau>
        <power_load>6.0</power_load>
        <start_draining>true</start_draining>
        <fix_issue_225>true</fix_issue_225>
        <enable_recharge>true</enable_recharge>
        <charging_time>0.04</charging_time>
        <recharge_by_topic>true</recharge_by_topic>
      </plugin>
    </model>
  </world>
</sdf>
